# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://bahregram:password@localhost:5432/bahregram
DATABASE_MAX_CONNECTIONS=25

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRY=7d

# ─── Auth: managed identity (Clerk), RS256 + JWKS ─────────────────────────────
# OFF by default. While CLERK_ENABLED is false the API keeps using the HS256
# tokens minted by /auth/register and /auth/login, unchanged. Both paths
# coexist; there is no cutover yet.
#
# When true, CLERK_ISSUER is required and the API fails at boot without it.
# Tokens must be RS256, signed by a key published at CLERK_JWKS_URL, carry the
# exact CLERK_ISSUER as `iss`, and — when CLERK_AUDIENCE is set — that value in
# `aud`. The `sub` claim is mapped to users.clerk_user_id; the internal UUID
# stays the primary key everywhere.
CLERK_ENABLED=false
CLERK_ISSUER=
CLERK_AUDIENCE=
# Defaults to CLERK_ISSUER + /.well-known/jwks.json
CLERK_JWKS_URL=
# How long a fetched key set is trusted. Past it, a failed refresh fails CLOSED.
CLERK_JWKS_CACHE_TTL=10m
# Rate-limits refreshes triggered by an unknown `kid`, so forged key ids cannot
# turn into one outbound fetch per request.
CLERK_JWKS_MIN_REFRESH_INTERVAL=1m
CLERK_JWKS_REQUEST_TIMEOUT=5s
# How long a verified Clerk-ID -> internal-UUID mapping is cached in Redis.
CLERK_USER_MAP_CACHE_TTL=5m

# ─── API ──────────────────────────────────────────────────────────────────────
API_PORT=8080
API_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ─── Web App ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# ─── Storage ──────────────────────────────────────────────────────────────────
# local = the API's own disk under UPLOAD_ROOT (development default; serves
#         everything unsigned and does not enforce the public/private split)
# s3    = any S3-compatible server; Deco runs MinIO
# An unrecognised value fails at boot, not on the first upload.
STORAGE_BACKEND=local
UPLOAD_ROOT=./uploads
PUBLIC_UPLOAD_BASE=/api/v1/media

# Only read when STORAGE_BACKEND=s3.
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_PUBLIC_BUCKET=deco-public
STORAGE_PRIVATE_BUCKET=deco-private
# Browser-reachable origin for the public bucket. Persisted onto user and
# sticker rows, so it must not be an internal container hostname.
STORAGE_PUBLIC_BASE_URL=
# Lifetime of a presigned attachment URL. Capped at 1h.
STORAGE_PRESIGN_TTL=5m

# ─── Storage (Cloudflare R2) — unused placeholders ────────────────────────────
# Not read by the storage backend. Kept for a possible future decision.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bahregram-media
R2_PUBLIC_URL=

# ─── AI (Anthropic) ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Bahregram
APP_URL=https://yourdomain.com
