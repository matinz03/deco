POSTGRES_PASSWORD=change-this-strong-password
REDIS_PASSWORD=change-this-strong-password
JWT_SECRET=change-this-to-64-random-characters
APP_URL=https://yourdomain.com
APP_URL_WS=wss://yourdomain.com
# Object storage — MinIO. These credentials are MinIO's root account and the
# API's S3 credentials; the API needs them to create its buckets at boot.
# Generate strong values; this account can read every attachment.
MINIO_ROOT_USER=change-this-access-key
MINIO_ROOT_PASSWORD=change-this-strong-password

# Browser-reachable origin for the PUBLIC bucket (avatars and stickers), e.g.
# https://media.yourdomain.com. Route it through the same reverse proxy that
# fronts api/web — MinIO itself is bound to 127.0.0.1. This value is written
# onto user and sticker rows, so changing it later does not rewrite them.
STORAGE_PUBLIC_BASE_URL=

# Optional overrides; the defaults are fine.
# STORAGE_PUBLIC_BUCKET=deco-public
# STORAGE_PRIVATE_BUCKET=deco-private
# STORAGE_PRESIGN_TTL=5m

# Unused placeholders — the storage backend does not read these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bahregram-media
R2_PUBLIC_URL=
ANTHROPIC_API_KEY=
