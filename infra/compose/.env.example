POSTGRES_PASSWORD=change-this-strong-password
REDIS_PASSWORD=change-this-strong-password
JWT_SECRET=change-this-to-64-random-characters
DECO_ALLOW_LEGACY_GROUP_KEY_MIGRATION=0
APP_URL=https://yourdomain.com
APP_URL_WS=wss://yourdomain.com

# Clerk is the production identity provider. The issuer is shown in Clerk's
# JWT template/session-token settings and normally ends in clerk.accounts.dev.
CLERK_ENABLED=true
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Optional exact audience and JWKS override; leave blank unless configured.
CLERK_AUDIENCE=
CLERK_JWKS_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me
# Object storage — MinIO. These credentials are MinIO's root account and the
# API's S3 credentials; the API needs them to create its buckets at boot.
# Generate strong values; this account can read every attachment.
STORAGE_BACKEND=s3
MINIO_ROOT_USER=change-this-access-key
MINIO_ROOT_PASSWORD=change-this-strong-password

# Browser-reachable URL prefix for the PUBLIC bucket (avatars and stickers), e.g.
# https://media.yourdomain.com/deco-public. Route it through the reverse proxy that
# fronts api/web — MinIO itself is bound to 127.0.0.1. This value is written
# onto user and sticker rows, so changing it later does not rewrite them.
STORAGE_PUBLIC_BASE_URL=https://media.yourdomain.com/deco-public
# Browser-reachable S3 API endpoint used for private presigned downloads.
# It must route to MinIO and allow the APP_URL origin.
STORAGE_S3_PRESIGN_ENDPOINT=https://media.yourdomain.com

# Optional overrides; the defaults are fine.
# STORAGE_PUBLIC_BUCKET=deco-public
# STORAGE_PRIVATE_BUCKET=deco-private
# STORAGE_PRESIGN_TTL=5m

# Unused placeholders — the storage backend does not read these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=bahregram-media
R2_PUBLIC_URL=
ANTHROPIC_API_KEY=

# Mandatory off-host backup destination used by backup.sh before each update.
# Use a separate S3-compatible provider/account from this VPS. Quote values
# containing shell-special characters because backup.sh reads this file.
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_ACCESS_KEY_ID=change-this-backup-access-key
BACKUP_S3_SECRET_ACCESS_KEY=change-this-backup-secret
BACKUP_S3_BUCKET=deco-backups
# BACKUP_S3_PREFIX=deco
# BACKUP_RETENTION_DAYS=30
# BACKUP_ALLOW_INSECURE=0
