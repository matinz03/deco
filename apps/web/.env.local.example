# Next.js reads environment files from apps/web, not the repository root.
# Defaults match the repository-root .env.example for a working local setup.
# For Clerk, change CLERK_ENABLED and NEXT_PUBLIC_AUTH_MODE together and set
# both server-side Clerk values and the publishable key in the same cutover.
NEXT_PUBLIC_AUTH_MODE=legacy
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000
